{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://heba920908.github.io/octo-robot-kva/schemas/hero.schema.json",
  "title": "Hero content",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "overline",
    "headline",
    "lead",
    "primaryCta",
    "secondaryCta",
    "proofPoint",
    "logo"
  ],
  "properties": {
    "id": { "const": "hero" },
    "overline": { "type": "string", "pattern": "\\S" },
    "headline": { "type": "string", "pattern": "\\S", "maxLength": 60 },
    "lead": { "type": "string", "pattern": "\\S", "maxLength": 120 },
    "primaryCta": { "type": "string", "pattern": "\\S" },
    "secondaryCta": { "type": "string", "pattern": "\\S" },
    "proofPoint": { "type": "string", "pattern": "\\S" },
    "logo": {
      "type": "object",
      "additionalProperties": false,
      "required": ["src", "src2x", "width", "height"],
      "properties": {
        "src": { "type": "string", "pattern": "^media/logo/[a-z0-9-]+\\.png$" },
        "src2x": { "type": "string", "pattern": "^media/logo/[a-z0-9-]+\\.png$" },
        "width": { "type": "integer", "minimum": 1 },
        "height": { "type": "integer", "minimum": 1 }
      }
    }
  }
}
