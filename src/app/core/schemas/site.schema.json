{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://heba920908.github.io/octo-robot-kva/schemas/site.schema.json",
  "title": "Site content",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "language",
    "brandName",
    "pageTitle",
    "heading",
    "description",
    "canonicalUrl",
    "iconPath",
    "contact",
    "facts",
    "footerYear",
    "footerLogo",
    "headerLogo",
    "contactLogo"
  ],
  "properties": {
    "id": { "const": "site" },
    "language": { "const": "es-MX" },
    "brandName": { "const": "kVA Instalaciones" },
    "pageTitle": { "type": "string", "minLength": 1, "maxLength": 70 },
    "heading": { "type": "string", "minLength": 1, "maxLength": 60 },
    "description": { "type": "string", "minLength": 1, "maxLength": 160 },
    "canonicalUrl": { "type": "string", "format": "uri", "pattern": "^https://" },
    "iconPath": { "type": "string", "pattern": "^media/[a-z0-9-]+\\.png$" },
    "contact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["email"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "email": { "type": "string", "pattern": "^[^\\s@]+@[^\\s@]+$" },
        "phone": {
          "type": "object",
          "additionalProperties": false,
          "required": ["e164", "display"],
          "properties": {
            "e164": { "type": "string", "pattern": "^\\+52[1-9][0-9]{9}$" },
            "display": {
              "type": "string",
              "pattern": "^(\\([0-9]{2}\\) [0-9]{4}|\\([0-9]{3}\\) [0-9]{3}) [0-9]{4}$"
            }
          }
        },
        "whatsapp": { "type": "string", "pattern": "^\\+52[1-9][0-9]{9}$" }
      }
    },
    "facts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["yearsInBusiness", "coverage"],
      "properties": {
        "yearsInBusiness": { "type": "string", "minLength": 1 },
        "coverage": { "type": "string", "minLength": 1 }
      }
    },
    "legalIdentity": { "type": "string", "minLength": 1 },
    "retentionPeriod": { "type": "string", "minLength": 1 },
    "footerYear": { "type": "integer", "minimum": 2000 },
    "footerLogo": {
      "type": "object",
      "additionalProperties": false,
      "required": ["src", "src2x", "width", "height"],
      "properties": {
        "src": { "type": "string", "pattern": "^media/logo/[a-z0-9-]+\\.png$" },
        "src2x": { "type": "string", "pattern": "^media/logo/[a-z0-9-]+\\.png$" },
        "width": { "type": "integer", "minimum": 1 },
        "height": { "type": "integer", "minimum": 1 }
      }
    },
    "headerLogo": {
      "type": "object",
      "additionalProperties": false,
      "required": ["src", "src2x", "width", "height"],
      "properties": {
        "src": { "type": "string", "pattern": "^media/logo/[a-z0-9-]+\\.png$" },
        "src2x": { "type": "string", "pattern": "^media/logo/[a-z0-9-]+\\.png$" },
        "width": { "type": "integer", "minimum": 1 },
        "height": { "type": "integer", "minimum": 1 }
      }
    },
    "contactLogo": {
      "type": "object",
      "additionalProperties": false,
      "required": ["src", "src2x", "width", "height"],
      "properties": {
        "src": { "type": "string", "pattern": "^media/logo/[a-z0-9-]+\\.png$" },
        "src2x": { "type": "string", "pattern": "^media/logo/[a-z0-9-]+\\.png$" },
        "width": { "type": "integer", "minimum": 1 },
        "height": { "type": "integer", "minimum": 1 }
      }
    }
  }
}
