{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://heba920908.github.io/octo-robot-kva/schemas/privacy-notice.schema.json",
  "title": "Privacy notice content",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "title", "sections"],
  "properties": {
    "id": { "const": "privacy-notice" },
    "title": { "type": "string", "pattern": "\\S" },
    "sections": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "heading", "paragraphs"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$" },
          "heading": { "type": "string", "pattern": "\\S" },
          "paragraphs": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string", "pattern": "\\S" }
          }
        }
      }
    }
  }
}
