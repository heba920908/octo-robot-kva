        {
          "properties": {
            "parameters": {
              "const": ["n", "servicio"]
            },
            "text": {
              "type": "string",
              "pattern": "^(?=[\\s\\S]*\\{n\\})(?=[\\s\\S]*\\{servicio\\})(?:[^{}]|\\{(?:n|servicio)\\})*$"
            }
          },
          "type": "object"
        }
