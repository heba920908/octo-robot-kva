{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kvainstalaciones.mx/schemas/ui-strings.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "skipLink",
    "logoLink",
    "headerWordmark",
    "navServices",
    "navProjects",
    "navAbout",
    "navTrust",
    "navContact",
    "menu",
    "headerContact",
    "headerContactShort",
    "servicesTitle",
    "projectsTitle",
    "aboutTitle",
    "trustTitle",
    "contactTitle",
    "clientsHeading",
    "serviceQuote",
    "serviceVisit",
    "servicesExpand",
    "servicesCollapse",
    "projectFilter",
    "filterAll",
    "filterCount",
    "filterTotal",
    "filterEmpty",
    "filterReset",
    "placeholder",
    "projectQuote",
    "projectScope",
    "projectOutcome",
    "projectClient",
    "projectLocation",
    "projectYear",
    "projectStandards",
    "carouselName",
    "carouselPrevious",
    "carouselNext",
    "carouselPosition",
    "carouselGoTo",
    "carouselAnnouncement",
    "carouselRole",
    "carouselSlideRole",
    "overlayClose",
    "composerTitle",
    "composerIntro",
    "requiredNote",
    "emailLabel",
    "emailHint",
    "serviceLabel",
    "serviceEmpty",
    "consentLabel",
    "consentLink",
    "submit",
    "emailRequired",
    "emailInvalid",
    "serviceRequired",
    "consentRequired",
    "errorSummarySingle",
    "errorSummaryPlural",
    "postSubmitHeading",
    "postSubmitFallback",
    "postSubmitDone",
    "postSubmitEdit",
    "postSubmitCopy",
    "copyName",
    "copySuccess",
    "copyFailure",
    "phoneName",
    "whatsappCta",
    "noJsContact",
    "footerPrivacy",
    "footerCopyright",
    "mailSubjectComposer",
    "mailSubjectDirect",
    "mailBody",
    "whatsappPrefill"
  ],
  "$defs": {
    "item": {
      "type": "object",
      "additionalProperties": false,
      "required": ["text", "parameters"],
      "properties": {
        "text": {
          "type": "string",
          "pattern": "\\S"
        },
        "parameters": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        }
      }
    },
    "plain": {
      "allOf": [
        {
          "$ref": "#/$defs/item"
        },
        {
          "properties": {
            "parameters": {
              "const": []
            },
            "text": {
              "type": "string",
              "pattern": "^[^{}]*$"
            }
          },
          "type": "object"
        }
      ]
    },
    "n": {
      "allOf": [
        {
          "$ref": "#/$defs/item"
        },
        {
          "properties": {
            "parameters": {
              "const": ["n"]
            },
            "text": {
              "type": "string",
              "pattern": "^(?=[\\s\\S]*\\{n\\})(?:[^{}]|\\{(?:n)\\})*$"
            }
          },
          "type": "object"
        }
      ]
    }
  },
  "properties": {
    "skipLink": {
      "$ref": "#/$defs/plain"
    },
    "logoLink": {
      "$ref": "#/$defs/plain"
    },
    "headerWordmark": {
