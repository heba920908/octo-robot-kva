{
  "name": "agency-portfolio",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "build:pages": "ng build --configuration production,pages",
    "preview:pages": "node scripts/preview-pages.mjs",
    "verify:static": "node scripts/verify-static-build.mjs",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "tokens:build": "node scripts/design-tokens.mjs",
    "tokens:check": "node scripts/design-tokens.mjs --check",
    "agents:install": "npm run agents:bmad && npm run agents:speckit",
    "agents:bmad": "bmad install --directory . --modules bmm --tools github-copilot --set core.project_name=agency-portfolio --yes",
    "agents:speckit": "uv venv --allow-existing .venv && uv pip install --python .venv --upgrade \"specify-cli @ git+https://github.com/github/spec-kit.git\" && .venv/bin/specify init --here --integration copilot --script sh --non-interactive --force --ignore-agent-tools",
    "agents:update": "npm install --save-dev bmad-method@latest && npm run agents:install"
  },
  "private": true,
  "packageManager": "npm@10.9.8",
  "dependencies": {
    "@angular/cdk": "22.2.4",
    "@angular/common": "^22.2.0",
    "@angular/compiler": "^22.2.0",
    "@angular/core": "^22.2.0",
    "@angular/forms": "^22.2.0",
    "@angular/material": "22.2.4",
    "@angular/platform-browser": "^22.2.0",
    "@angular/platform-server": "22.2.3",
    "@angular/router": "^22.2.0",
    "@angular/ssr": "22.2.4",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^22.2.3",
    "@angular/cli": "^22.2.3",
    "@angular/compiler-cli": "^22.2.0",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "bmad-method": "^6.12.4",
    "jsdom": "^30.0.0",
    "prettier": "^3.8.1",
    "typescript": "~6.0.2",
    "vitest": "^5.0.0",
    "yaml": "2.9.1"
  }
}
